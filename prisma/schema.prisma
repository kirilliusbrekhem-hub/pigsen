// PIGSEN data model.
// Postgres (Supabase). DATABASE_URL is the pooled connection used at runtime, DIRECT_URL the direct one for `prisma db push`.
// String-typed "enum" columns (type, role, status) are validated in lib/validation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  blocked       Boolean        @default(false)
  /// Bumped to revoke every issued session token (password change, "log out everywhere").
  sessionVersion Int           @default(0)
  adminGrant    AdminGrant?
  profile       Profile?
  progress      Progress[]
  savedItems    SavedItem[]
  conversations Conversation[]
  views         ContentView[]
  searches      SearchQuery[]
  quizAttempts  QuizAttempt[]
  ideaReviews   IdeaReview[]
  savingsGoals  SavingsGoal[]
  coinTxs       CoinTx[]
  purchases     Purchase[]
  payments      Payment[]
  invitedBy     Referral?      @relation("invitee")
  invites       Referral[]     @relation("inviter")
  review        Review?
  challenges    ChallengeDone[]
  posts         CommunityPost[]
  pushSubs      PushSub[]
  postLikes     PostLike[]
  chatMessages  ChatMessage[]
  dmSent        DirectMessage[] @relation("dmFrom")
  dmReceived    DirectMessage[] @relation("dmTo")
  simRuns       SimRun[]
}

model Profile {
  id                String   @id @default(cuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatar            String? // small data URL (validated, <= 200 KB)
  bio               String   @default("")
  interests         String   @default("[]") // JSON array of Category slugs
  onboarded         Boolean  @default(false)
  // Settings
  theme             String   @default("system") // system | light | dark
  aiTone            String   @default("balanced") // concise | balanced | detailed
  dailyGoalMinutes  Int      @default(15)
  notifyDigest      Boolean  @default(true)
  notifyNewContent  Boolean  @default(true)
  // Gamification: xp total, streak of consecutive active days (UTC), last active day as YYYY-MM-DD
  plan              String   @default("free")
  xp                Int      @default(0)
  streak            Int      @default(0)
  lastActiveAt      DateTime @default(now())
  bestStreak        Int      @default(0)
  // Internal currency (PigCoins) balance; CoinTx is the ledger. Pro is active while proUntil is in the future.
  coins             Int      @default(0)
  proUntil          DateTime?
  /// Pro tier of the last paid plan: pro | pro7 | pro10 (team size in «Мой бизнес»). Null = pro.
  proTier           String?
  // Pro trial bought for PigCoin$: raised limits, not full Pro
  liteUntil         DateTime?
  streakFreezes     Int      @default(0)
  title             String   @default("")
  lastActiveDay     String   @default("")
  // Shop effects: x2 XP until, Pro-content pass until, extra savings goal slots, equipped cosmetics
  xpBoostUntil      DateTime?
  passUntil         DateTime?
  extraGoals        Int      @default(0)
  nameColor         String   @default("")
  avatarRing        String   @default("")
  // Profile customization: background preset and emblem next to the name (see lib/profile/cosmetics.ts)
  profileBg         String   @default("")
  profileEmblem     String   @default("")
  updatedAt         DateTime @updatedAt
}

model Category {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String
  icon        String
  order       Int           @default(0)
  contents    ContentItem[]
  courses     Course[]
}

model ContentItem {
  id          String        @id @default(cuid())
  slug        String        @unique
  title       String
  description String
  body        String? // markdown notes/summary shown inside PIGSEN
  type        String // article | book | video | podcast | course
  author      String
  source      String
  url         String? // external original; null for in-app materials
  image       String?
  publishedAt DateTime
  readingTime Int // minutes
  tags        String        @default("") // comma separated, lowercase
  featured    Boolean       @default(false)
  trending    Int           @default(0) // editorial "hot topic" weight
  searchText  String        @default("") // lowercased title+description+tags+author for search
  // Set when an admin edits the item: the build-time seed then leaves it alone.
  adminEdited Boolean       @default(false)
  // Exclusive material: full text (or lessons after the first) only for Pro
  premium     Boolean       @default(false)
  createdAt   DateTime      @default(now())
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id])
  course      Course?
  savedBy     SavedItem[]
  views       ContentView[]

  @@index([categoryId])
  @@index([type])
}

model Course {
  id            String       @id @default(cuid())
  slug          String       @unique
  title         String
  description   String
  level         String // beginner | intermediate | advanced
  order         Int          @default(0)
  searchText    String       @default("")
  categoryId    String
  category      Category     @relation(fields: [categoryId], references: [id])
  contentItemId String?      @unique
  contentItem   ContentItem? @relation(fields: [contentItemId], references: [id])
  lessons       Lesson[]
  createdAt     DateTime     @default(now())
}

model Lesson {
  id          String     @id @default(cuid())
  slug        String
  title       String
  summary     String
  body        String // markdown
  order       Int
  durationMin Int
  searchText  String     @default("")
  courseId    String
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  progress    Progress[]
  quizzes     QuizAttempt[]

  @@unique([courseId, slug])
  @@index([courseId, order])
}

model Progress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status      String    @default("in_progress") // in_progress | completed
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId, status])
}

model SavedItem {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@unique([userId, contentItemId])
  @@index([userId, createdAt])
}

model ContentView {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItemId String
  contentItem   ContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  createdAt     DateTime    @default(now())

  @@index([userId, createdAt])
}

model SearchQuery {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  query     String
  results   Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  messages  Message[]

  @@index([userId, updatedAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant | system
  content        String
  metadata       String? // JSON: provider, related content ids
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

/// One generated quiz for a lesson. `questions` holds JSON with correct answers and stays server-side.
model QuizAttempt {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions   String
  total       Int
  score       Int?
  xpAwarded   Int       @default(0)
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId, lessonId])
}

/// A $PIG review of a business idea. `result` is the JSON card shown to the user.
model IdeaReview {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea      String
  result    String
  score     Int
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Smart piggy bank: a goal with a running balance; entries are deposits (+) and withdrawals (-) in whole rubles.
model SavingsGoal {
  id         String         @id @default(cuid())
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  why        String         @default("")
  target     Int
  saved      Int            @default(0)
  theme      String         @default("piggy")
  deadline   DateTime?
  milestones Int            @default(0) // highest 25%-step already rewarded (0–4)
  image      String? // user's motivation picture, small data URL
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  entries    SavingsEntry[]

  @@index([userId, createdAt])
}

model SavingsEntry {
  id        String      @id @default(cuid())
  goalId    String
  goal      SavingsGoal @relation(fields: [goalId], references: [id], onDelete: Cascade)
  amount    Int
  note      String      @default("")
  createdAt DateTime    @default(now())

  @@index([goalId, createdAt])
}

model CoinTx {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount    Int
  reason    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model Purchase {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId    String
  createdAt DateTime @default(now())

  @@unique([userId, itemId])
}

// Real-money payments. YooKassa: id is the provider's payment id. Telegram Stars: id is ours (sent as the invoice payload), providerRef is the Telegram charge id.
model Payment {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan      String
  amount    Int
  status    String   @default("pending") // pending | succeeded | canceled
  applied   Boolean  @default(false)
  provider  String   @default("yookassa")
  providerRef String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// Seeded library items an admin deleted, so the next build doesn't bring them back.
model DeletedSlug {
  slug      String   @id
  createdAt DateTime @default(now())
}

// Once-a-day reward claims ("reason:YYYY-MM-DD"); the primary key makes the daily limit race-proof.
model DailyClaim {
  userId    String
  key       String
  createdAt DateTime @default(now())

  @@id([userId, key])
}

/// Invite: inviter is rewarded once the invitee is activated (first completed lesson).
model Referral {
  id        String   @id @default(cuid())
  inviterId String
  inviter   User     @relation("inviter", fields: [inviterId], references: [id], onDelete: Cascade)
  inviteeId String   @unique
  invitee   User     @relation("invitee", fields: [inviteeId], references: [id], onDelete: Cascade)
  rewarded  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([inviterId, createdAt])
}

/// One review per user; paid in PigCoin$ and Pro days after admin approval.
model Review {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  text      String
  status    String   @default("pending") // pending | approved | rejected
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Offline challenge completed by a user (challenges are defined in code).
model ChallengeDone {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  challengeId String
  note        String   @default("")
  createdAt   DateTime @default(now())

  @@id([userId, challengeId])
}

/// Pro community feed: top-level posts and replies (parentId).
model CommunityPost {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  parentId  String?
  kind      String          @default("post") // post | win (success story) | question
  topic     String          @default("") // business | startups | savings | investing | other
  likes     PostLike[]
  parent    CommunityPost?  @relation("replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CommunityPost[] @relation("replies")
  createdAt DateTime        @default(now())

  @@index([parentId, createdAt])
}

/// Web Push subscription of a browser.
model PushSub {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

model PostLike {
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  postId    String
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@id([userId, postId])
  @@index([postId])
}

/// Message in a topic chat room (Pro only). Rooms are defined in code.
model ChatMessage {
  id        String   @id @default(cuid())
  room      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime @default(now())

  @@index([room, createdAt])
}

/// Private message between two users (Pro only to start a conversation).
model DirectMessage {
  id        String    @id @default(cuid())
  fromId    String
  from      User      @relation("dmFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId      String
  to        User      @relation("dmTo", fields: [toId], references: [id], onDelete: Cascade)
  text      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([fromId, toId, createdAt])
  @@index([toId, readAt])
}

/// Where a user came from (first-touch UTM), saved at registration.
model Attribution {
  userId    String   @id
  source    String   @default("")
  medium    String   @default("")
  campaign  String   @default("")
  content   String   @default("")
  landing   String   @default("")
  referrer  String   @default("")
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}

/// Anonymous landing visit (one per visitor per day) for the funnel top.
model Visit {
  id        String   @id @default(cuid())
  visitorId String
  day       String
  source    String   @default("")
  campaign  String   @default("")
  path      String   @default("")
  createdAt DateTime @default(now())

  @@unique([visitorId, day])
  @@index([day])
}

/// Admin access. Bootstrap: the first ADMIN_EMAILS user to sign in claims it while the table is empty.
model AdminGrant {
  userId    String   @id
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

/// Fixed-window rate limiter shared across serverless instances.
model RateHit {
  key     String   @id
  count   Int
  resetAt DateTime
}

/// Duels: 1v1 speed quiz. Questions (with answers) live only on the server in `questions` (JSON snapshot).
model Duel {
  id         String       @id @default(cuid())
  code       String       @unique
  /// friend | random | ghost | bot
  kind       String
  /// waiting | active | done | cancelled
  status     String       @default("waiting")
  stake      Int          @default(0)
  questions  String
  creatorId  String
  rematchId  String?
  createdAt  DateTime     @default(now())
  startedAt  DateTime?
  finishedAt DateTime?
  players    DuelPlayer[]

  @@index([status, kind, stake, createdAt])
  @@index([creatorId, createdAt])
}

model DuelPlayer {
  id           String       @id @default(cuid())
  duelId       String
  duel         Duel         @relation(fields: [duelId], references: [id], onDelete: Cascade)
  /// null for a bot / ghost
  userId       String?
  name         String
  isBot        Boolean      @default(false)
  stake        Int          @default(0)
  score        Int          @default(0)
  correct      Int          @default(0)
  current      Int          @default(0)
  qStartedAt   DateTime?
  lastActiveAt DateTime     @default(now())
  finishedAt   DateTime?
  /// win | loss | draw
  result       String?
  joinedAt     DateTime     @default(now())
  answers      DuelAnswer[]

  @@unique([duelId, userId])
  @@index([userId, joinedAt])
  @@index([result, finishedAt])
}

model DuelAnswer {
  id        String     @id @default(cuid())
  playerId  String
  player    DuelPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  q         Int
  choice    Int
  correct   Boolean
  ms        Int
  points    Int

  @@unique([playerId, q])
}

/// Quest progress counter per user, period ("d:YYYY-MM-DD" daily, "w:YYYY-MM-DD" week starting Monday) and quest kind.
/// Rewards are claimed through DailyClaim keys, so a counter row only ever increments.
model QuestProgress {
  userId    String
  period    String
  kind      String
  progress  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([userId, period, kind])
}

/// Business plan from the "Бизнес-план за 10 минут" wizard. input: PlanInput JSON; sections: AI/template text.
/// Numbers are recomputed from input by lib/bizplan/model.ts on every read, never stored or written by AI.
model BizPlan {
  id        String   @id @default(cuid())
  userId    String
  title     String
  input     Json
  sections  Json
  aiDemo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
}

/// Business simulator run. State and per-week history are computed only by lib/sim/engine.ts.
model SimRun {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String
  seed       Int
  week       Int       @default(0)
  status     String    @default("active") // active | finished | bankrupt
  state      Json
  history    Json      @default("[]")
  score      Int?
  reward     Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  finishedAt DateTime?

  @@index([userId, createdAt])
}

/// «Разбор трат»: only the aggregated result of one statement analysis is kept (never the uploaded file or rows).
/// A deleted analysis keeps its timestamp (result wiped) so the weekly Free quota can't be reset by deleting.
model SpendAnalysis {
  id        String    @id @default(cuid())
  userId    String
  source    String
  txCount   Int
  total     Int
  result    Json?
  deletedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// «Мой бизнес»: a persistent virtual business that grows only from members' real savings (lib/biz/*).
/// capital mirrors savings deposits/withdrawals since joining; every number is computed by lib/biz/engine.ts, never by AI.
model BizBusiness {
  id         String        @id @default(cuid())
  kind       String        @default("coffee")
  name       String
  founderId  String
  inviteCode String        @unique
  capital    Int           @default(0)
  rating     Float         @default(3)
  dayNo      Int           @default(1)
  lastDay    String
  seed       Int
  revenue    Int           @default(0)
  maxLevel   Int           @default(1)
  state      Json          @default("{}")
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt
  members    BizMember[]
  upgrades   BizUpgrade[]
  events     BizEvent[]
  chat       BizChat[]

  @@index([founderId])
}

/// One business per user (userId unique). contributed = net savings delta since joining.
model BizMember {
  id          String      @id @default(cuid())
  businessId  String
  business    BizBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId      String      @unique
  name        String
  role        String      @default("member") // founder | member
  contributed Int         @default(0)
  joinedAt    DateTime    @default(now())

  @@index([businessId])
}

model BizUpgrade {
  id         String      @id @default(cuid())
  businessId String
  business   BizBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  itemId     String
  status     String      @default("ok") // ok | broken
  price      Int
  boughtBy   String?
  createdAt  DateTime    @default(now())

  @@unique([businessId, itemId])
}

/// Team feed / timeline. userId is null for system and $PIG events.
model BizEvent {
  id         String      @id @default(cuid())
  businessId String
  business   BizBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  kind       String
  text       String
  userId     String?
  amount     Int?
  createdAt  DateTime    @default(now())

  @@index([businessId, createdAt])
  @@index([userId])
}

/// Team chat. userId null = $PIG.
model BizChat {
  id         String      @id @default(cuid())
  businessId String
  business   BizBusiness @relation(fields: [businessId], references: [id], onDelete: Cascade)
  userId     String?
  name       String
  text       String
  createdAt  DateTime    @default(now())

  @@index([businessId, createdAt])
  @@index([userId])
}
