# Database: Postgres (Supabase). Project Settings → Database → Connection string.
# Runtime uses the pooled "Transaction" URL (port 6543); prisma db push uses the direct one (port 5432).
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Secret used to sign session cookies. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# $PIG AI: YandexGPT (console.yandex.cloud). Takes priority over the others when both values are set.
YANDEX_API_KEY=""
YANDEX_FOLDER_ID=""
# Optional model override
YANDEX_MODEL="" # default: yandexgpt-lite/latest, falls back to yandexgpt/latest

# $PIG AI: Google Gemini (aistudio.google.com/apikey). Takes priority over Anthropic when set.
GEMINI_API_KEY=""
# Optional model override
GEMINI_MODEL="" # default: gemini-3.8-flash-lite, falls back to gemini-3.8-flash

# $PIG AI via Anthropic. Leave both keys empty to run with the built-in demo (mock) provider.
ANTHROPIC_API_KEY=""
# Optional model override
ANTHROPIC_MODEL="claude-opus-5-5"

# Payments for PIGSEN Pro via YooKassa (yookassa.ru → Integration → API keys). Leave empty: the Pro page shows "оплата скоро".
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
# Set to 1 if your shop sends fiscal receipts (54-FZ) through YooKassa.
YOOKASSA_RECEIPTS=""

# Payments for Pro via Telegram Stars (preferred when set). Bot token from @BotFather; secret: any long random string.
# After deploying, open https://<site>/api/telegram/setup?key=<TELEGRAM_WEBHOOK_SECRET> once to connect the bot.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_WEBHOOK_SECRET=""
# Optional prices in Stars (defaults 250 and 2000)
STARS_MONTH=""
STARS_YEAR=""

# Admin panel (/admin): emails of admins, comma separated. Everyone else gets "page not found".
ADMIN_EMAILS=""

# Web Push reminders for the piggy bank. Generate a pair: npx web-push generate-vapid-keys
# Leave empty: the "Включить напоминания" button is hidden.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
# Protects /api/cron/* (Vercel Cron sends "Authorization: Bearer <CRON_SECRET>" automatically). Generate: openssl rand -base64 32
CRON_SECRET=""
# Yandex.Metrica counter number (digits only). Optional: empty = counter not loaded. Goals: register, first_lesson, pro_click, pro_trial.
NEXT_PUBLIC_YM_ID=""
# Google Analytics 4 Measurement ID (G-XXXXXXX). Optional. Events: sign_up, first_lesson, begin_checkout, pro_trial.
NEXT_PUBLIC_GA_ID=""
