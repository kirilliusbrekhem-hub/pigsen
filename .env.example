# Database: Postgres (Supabase). Project Settings → Database → Connection string.
# Runtime uses the pooled "Transaction" URL (port 6543); prisma db push uses the direct one (port 5432).
DATABASE_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# Secret used to sign session cookies. Generate: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# $PIG AI: Google Gemini (aistudio.google.com/apikey). Takes priority over Anthropic when set.
GEMINI_API_KEY=""
# Optional model override
GEMINI_MODEL="" # default: gemini-3.8-flash-lite, falls back to gemini-3.8-flash

# $PIG AI via Anthropic. Leave both keys empty to run with the built-in demo (mock) provider.
ANTHROPIC_API_KEY=""
# Optional model override
ANTHROPIC_MODEL="claude-opus-5-5"
